{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/inject-rules.py"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/prune-rules-cache"
          }
        ]
      }
    ]
  }
}
