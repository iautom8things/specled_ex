# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# Generated by `mix spec.cover.test` for per-test coverage triangulation.
/.spec/_coverage/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# Gate forensics (SPECLED_COMMAND_OUTPUT_DIR). The agent-shell default in
# .claude/settings.json is a RELATIVE path, so it resolves against whatever
# directory the gate was invoked from — `/tmp/` above only covers the repo
# root. The leading `**/` is load-bearing: a pattern with a slash anywhere but
# the end is anchored to this file's directory, so `tmp/specled-command-output/`
# would match only the root case `/tmp/` already covers.
**/tmp/specled-command-output/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
spec_led_ex-*.tar
.playwright-cli/
.spec/state.json

# Python bytecode (agent-rules hook scripts)
__pycache__/
